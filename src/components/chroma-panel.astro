---
// Tuning panel for the chroma effect in src/scripts/chroma.js. Layout.astro
// renders it only under `astro dev`, so it never ships. Settings stay in this
// browser; once they look right, they move into `defaults` in chroma.js.
// `scale` divides the value for its readout (px per second shows in thousands).
const sliders = [
	{ key: "split", label: "Split", min: 0, max: 40, step: 1, unit: "px" },
	{ key: "warp", label: "Warp", min: 0, max: 60, step: 1, unit: "" },
	{ key: "angle", label: "Angle", min: 0, max: 90, step: 5, unit: "°" },
	{
		key: "fullAt",
		label: "Full at",
		min: 1000,
		max: 10000,
		step: 500,
		unit: "k px/s",
		scale: 1000,
	},
];

const row = "grid grid-cols-[3.5rem_1fr_4.25rem] items-center gap-3";

const button =
	"h-8 px-3 rounded-full border border-rule transition-colors duration-200 hover:border-ink";
---

<!--
    A manual popover sits in the top layer, outside the root element, so the
    filter on the root doesn't split the panel along with the page.
    On phones it sits above the Astro dev toolbar.
-->
<aside
	id="chroma-panel"
	popover="manual"
	class="inset-auto bottom-20 sm:bottom-4 left-4 m-0 p-0 overflow-visible w-[min(19rem,calc(100vw-2rem))] data-collapsed:w-auto rounded-2xl border border-rule bg-page/95 backdrop-blur-xl text-label text-ink shadow-[0_18px_40px_-18px_rgb(17_24_39/0.35)]"
	aria-label="Chroma settings"
>
	<div class="flex items-center justify-between gap-3 h-11 pl-4 pr-1.5">
		<span class="font-semibold">Chroma</span>
		<button
			type="button"
			data-action="hide"
			aria-expanded="true"
			aria-controls="chroma-panel-body"
			class="h-8 px-3 rounded-full text-ink-muted transition-colors duration-200 hover:bg-wash hover:text-ink"
		>
			Hide
		</button>
	</div>

	<div id="chroma-panel-body" class="px-4 pb-4">
		{sliders.map((slider) => (
			<label class={`${row} h-9`}>
				<span class="text-ink-muted">{slider.label}</span>
				<input
					type="range"
					name={slider.key}
					min={slider.min}
					max={slider.max}
					step={slider.step}
					data-unit={slider.unit}
					data-scale={slider.scale ?? 1}
					class="w-full accent-brand"
				/>
				<output class="text-right tabular-nums" />
			</label>
		))}

		<!-- How fast the page is scrolling right now, and how much of the effect that gives. -->
		<div class={`${row} h-9`} aria-hidden="true">
			<span class="text-ink-muted">Speed</span>
			<span class="h-1.5 rounded-full bg-wash overflow-hidden">
				<span
					data-meter
					class="block h-full w-full origin-left scale-x-0 rounded-full bg-brand"
				></span>
			</span>
			<span data-speed class="text-right tabular-nums">0k px/s</span>
		</div>

		<p data-note class="mt-1 text-[0.75rem] leading-snug text-ink-faint">
			The faster you scroll, the further the colors part, up to Split and
			Warp at the Full at speed. Angle 0 parts them sideways, 90 along the
			scroll.
		</p>

		<button type="button" data-action="reset" class={`mt-3 ${button}`}>
			Reset
		</button>
	</div>
</aside>

<script>
	import {
		defaults,
		settings,
		live,
		saveSettings,
		showPeak,
	} from "../scripts/chroma.js";

	const panel = document.getElementById("chroma-panel");
	const body = document.getElementById("chroma-panel-body");
	const hide = panel.querySelector('[data-action="hide"]');
	const sliders = panel.querySelectorAll('input[type="range"]');
	const meter = panel.querySelector("[data-meter]");
	const speed = panel.querySelector("[data-speed]");

	function sync() {
		sliders.forEach((input) => {
			input.value = settings[input.name];
			input.nextElementSibling.textContent =
				settings[input.name] / Number(input.dataset.scale) + input.dataset.unit;
		});
	}

	// The readout follows the effect while the panel is open.
	function readout() {
		if (!body.hidden) {
			meter.style.scale = `${live.strength} 1`;
			speed.textContent = `${(live.speed / 1000).toFixed(1)}k px/s`;
		}
		requestAnimationFrame(readout);
	}

	sliders.forEach((input) => {
		input.addEventListener("input", () => {
			settings[input.name] = Number(input.value);
			saveSettings();
			sync();
			showPeak();
		});
	});

	panel.querySelector('[data-action="reset"]').addEventListener("click", () => {
		Object.assign(settings, defaults);
		saveSettings();
		sync();
		showPeak();
	});

	function setOpen(open) {
		body.hidden = !open;
		panel.toggleAttribute("data-collapsed", !open);
		hide.setAttribute("aria-expanded", String(open));
		hide.textContent = open ? "Hide" : "Show";
		try {
			localStorage.setItem("chroma-panel-open", String(open));
		} catch {}
	}

	hide.addEventListener("click", () => setOpen(body.hidden));

	try {
		setOpen(localStorage.getItem("chroma-panel-open") !== "false");
	} catch {}

	if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		panel.querySelector("[data-note]").textContent =
			"Motion is reduced on this device, so chroma is off.";
	}

	sync();
	readout();
	panel.showPopover();
</script>
