---
import { Icon } from "astro-icon/components";

const email = "hello@jeffglenn.me";

const elsewhere = [
	{
		label: "LinkedIn",
		icon: "linkedin",
		href: "https://www.linkedin.com/in/jeff-glenn-b821a6234/",
	},
	{ label: "GitHub", icon: "github", href: "https://github.com/jeffaglenn" },
];
---

<!--
    The header scrolls away with the page. <main> reaches up behind it so the
    glow shows through, and relative + z-30 keep its links above <main> (which
    becomes a stacking context while chroma.js's scroll filter is on).
-->
<header id="site-header" class="relative z-30">
	<div class="flex items-center gap-2 h-16 px-5 sm:px-8">
		<!-- Circles match the Say hello button's height, like the ones in the contact section. -->
		<ul class="flex items-center gap-2 ml-auto">
			{elsewhere.map((item) => (
				<li>
					<a
						href={item.href}
						class="flex items-center justify-center size-9 rounded-full border border-rule text-ink-muted transition-colors duration-200 hover:border-brand hover:text-brand"
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`${item.label} (opens in a new tab)`}
					>
						<Icon
							name={item.icon}
							aria-hidden="true"
							class="size-4"
						/>
					</a>
				</li>
			))}
		</ul>

		<a
			href={`mailto:${email}`}
			class="inline-flex items-center gap-2 h-9 px-4 rounded-full bg-brand text-white text-label font-medium transition-colors duration-200 hover:bg-brand-deep"
			aria-label={`Say hello: email ${email}`}
		>
			<Icon name="chat" aria-hidden="true" class="size-4" />
			Say hello
		</a>
	</div>
</header>
