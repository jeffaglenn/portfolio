---
import Layout from "@layouts/Layout.astro";
---

<Layout seo={{ title: "Page not found | Jeff Glenn", noindex: true }}>
	<section class="wrapper pt-12 sm:pt-20 pb-24 sm:pb-32">
		<h1 class="section-heading">Page not found</h1>

		<p class="mt-4 max-w-[48ch] text-ink-muted">
			There's nothing at this address. It may have moved, or the link may
			be mistyped.
		</p>

		<a
			href="/"
			class="mt-7 inline-flex items-center h-10 px-4 rounded-full border border-rule text-label font-medium text-ink transition-colors duration-200 hover:border-brand hover:text-brand"
		>
			Go to the homepage
		</a>
	</section>
</Layout>
