---
import Layout from "@layouts/Layout.astro";
import pic from "@images/profile.jpg";
import backpacking from "@images/backpacking.webp";
import hawaii from "@images/hawaii.webp";
import photo from "@images/photo.webp";
import sanibel from "@images/sanibel.webp";
import travel from "@images/travel.webp";

import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

const projectsData = await getCollection("projects");
const experienceData = (await getCollection("experience")).sort(
	(a, b) => a.data.id - b.data.id,
);

const email = "hello@jeffglenn.me";

// One fixed order for every project's stack: platform first, then front end.
const stackOrder = [
	"Craft CMS",
	"Wordpress",
	"Astro.js",
	"Alpine.js",
	"TailwindCSS",
	"GSAP",
	"Algolia",
];
const sortStack = (stack: string[]) =>
	[...stack].sort((a, b) => stackOrder.indexOf(a) - stackOrder.indexOf(b));

const sections = [
	{ label: "Work", href: "#work" },
	{ label: "About", href: "#about" },
	{ label: "Experience", href: "#experience" },
	{ label: "Contact", href: "#contact" },
];

const elsewhere = [
	{
		label: "LinkedIn",
		icon: "linkedin",
		href: "https://www.linkedin.com/in/jeff-glenn-b821a6234/",
	},
	{ label: "GitHub", icon: "github", href: "https://github.com/jeffaglenn" },
];

const hobbies = [
	{
		text: "backpacking in the Smoky Mountains",
		image: backpacking,
		alt: "Backpacking in the Smoky Mountains",
	},
	{ text: "Hawaii", image: hawaii, alt: "Hawaii" },
	{ text: "Sanibel Island", image: sanibel, alt: "Sanibel Island" },
	{ text: "photography", image: photo, alt: "One of my photographs" },
];
---

<Layout>
	<section class="wrapper pt-12 sm:pt-20">
		<img
			id="profile-pic"
			src={pic.src}
			alt="Jeff Glenn"
			width="460"
			height="460"
			fetchpriority="high"
			class="intro-pic size-28 sm:size-32 rounded-full bg-wash object-cover"
		/>

		<h1
			id="intro-name"
			class="mt-8 text-display font-name font-medium font-stretch-expanded tracking-[-0.03em]"
		>
			Jeff Glenn
		</h1>

		<p class="intro-rise mt-4 text-lede font-semibold" style="--i: 0">
			Web Designer &amp; Front-End Developer
		</p>
		<p class="intro-rise mt-1 text-lede text-ink-muted text-balance" style="--i: 1">
			Design and development, built around your story.
		</p>

		<p class="intro-rise mt-5 max-w-[65ch] text-ink-muted text-balance" style="--i: 2">
			Based in Memphis, working across web, print, motion, and photography
			since 2007.
		</p>

		<ul class="mt-7 flex flex-wrap items-center gap-1.5 sm:gap-2 text-label font-medium">
			{sections.map((section, i) => (
				<li class="intro-rise" style={`--i: ${i + 3}`}>
					<a
						href={section.href}
						class="inline-flex items-center h-10 px-3.5 sm:px-4 rounded-full border border-rule text-ink transition-colors duration-200 hover:border-brand hover:text-brand"
					>
						{section.label}
					</a>
				</li>
			))}
		</ul>
	</section>

	<section
		id="work"
		class="wrapper mt-20 sm:mt-28"
		aria-labelledby="work-heading"
	>
		<h2 id="work-heading" class="section-heading">
			Selected work
		</h2>

		<ul class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2">
			{projectsData.map((project) => (
				<li>
					<a
						href={project.data.url}
						class="project group relative block rounded-xl"
						target="_blank"
						rel="noopener noreferrer"
					>
						<div class="relative overflow-hidden rounded-xl border border-rule bg-wash" data-reveal="frame">
							<Image
								src={project.data.image.src}
								alt=""
								widths={[400, 800, 1200]}
								sizes="(min-width: 1024px) 488px, (min-width: 640px) 46vw, calc(100vw - 2.5rem)"
								class="aspect-[3/2] w-full object-cover object-top transition-transform duration-700 ease-out-expo group-hover:scale-[1.04]"
							/>
						</div>
						<!-- Outside the frame so the frame's clipping doesn't cut it off at the edges. -->
						<span class="visit-label" aria-hidden="true">
							Visit site
							<Icon name="arrow-up-right" class="size-3.5" />
						</span>
						<h3 class="mt-3 text-title font-semibold">
							<span class="draw-underline">{project.data.title}</span>
						</h3>
						<p class="mt-1 text-label text-ink-faint">
							{sortStack(project.data.technologies).join(" · ")}
							<span class="sr-only">
								(opens{" "}
								{project.data.url.replace(/^https?:\/\//, "")}{" "}
								in a new tab)
							</span>
						</p>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section
		id="about"
		class="wrapper mt-24 sm:mt-32"
		aria-labelledby="about-heading"
	>
		<h2 id="about-heading" class="section-heading">
			About
		</h2>

		<div class="mt-6 space-y-5 max-w-[65ch]">
			<p>
				I'm a Memphis-based designer and developer with over 18 years of
				experience in web, print, motion, and photography. I specialize
				in taking projects from concept to completion, focusing on clean,
				effective design and thoughtful problem-solving.
			</p>
			<p>
				As a partner at{" "}
				<a
					href="https://2dimes.com"
					class="link logo-hover"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="logo-float" aria-hidden="true" hidden>
						<Icon name="paradigm-logo" class="size-full" />
					</span>
					Paradigm Marketing &amp; Creative</a>, I help businesses refine their digital presence with a mix of
				strategy and creativity. I started freelancing in 2014 and
				worked with Paradigm for over five years before officially
				joining the team.
			</p>
			<p>
				Outside of work, I enjoy
				{hobbies.map((hobby) => (
					<>
						<span class="whitespace-nowrap"><button
							type="button"
							class="peek"
							aria-expanded="false"
						>
							<span class="peek-photo" aria-hidden="true" hidden>
								<Image
									src={hobby.image}
									alt={hobby.alt}
									widths={[240, 480]}
									sizes="240px"
									class="rounded-lg"
								/>
							</span>
							{hobby.text}</button>,</span>{" "}
					</>
				))}
				and
				<span class="whitespace-nowrap"><button type="button" class="peek" aria-expanded="false">
					<span class="peek-photo" aria-hidden="true" hidden>
						<Image
							src={travel}
							alt="Traveling with my family"
							widths={[240, 480]}
							sizes="240px"
							class="rounded-lg"
						/>
					</span>
					traveling to Disney with my family</button>.</span>
			</p>
		</div>
	</section>

	<section
		id="experience"
		class="wrapper mt-24 sm:mt-32"
		aria-labelledby="experience-heading"
	>
		<h2 id="experience-heading" class="section-heading">
			Experience
		</h2>

		<ol class="mt-6 border-t border-rule">
			{experienceData.map(async (experience) => {
				const { Content } = await render(experience);
				return (
					<li class="py-7 border-b border-rule">
						<div class="sm:flex sm:items-baseline sm:justify-between sm:gap-6">
							<h3 class="text-title font-semibold">
								{experience.data.position}
							</h3>
							<p class="mt-1 sm:mt-0 shrink-0 text-label text-ink-faint tabular-nums">
								{experience.data.dates}
							</p>
						</div>
						<p class="mt-0.5 text-ink-muted">
							{experience.data.companyUrl ? (
								<a
									href={experience.data.companyUrl}
									class="link"
									target="_blank"
									rel="noopener noreferrer"
								>
									{experience.data.company}
								</a>
							) : (
								experience.data.company
							)}
						</p>
						<div class="mt-3 max-w-[65ch] text-ink-muted">
							<Content />
						</div>
					</li>
				);
			})}
		</ol>
	</section>

	<section
		id="contact"
		class="mt-24 sm:mt-32 bg-brand text-white"
		aria-labelledby="contact-heading"
	>
		<div class="wrapper pt-16 sm:pt-24 pb-10">
		<h2 id="contact-heading" class="section-heading">
			Let's work together
		</h2>

		<p class="mt-4 max-w-[48ch]">
			Have a project in mind, or just want to say hello? Email is the
			fastest way to reach me.
		</p>

		<a
			href={`mailto:${email}`}
			class="link-inverse mt-6 inline-block text-headline font-semibold break-all"
		>
			{email}
		</a>

		<footer class="mt-20 sm:mt-28 pt-6 border-t border-white/30 flex flex-wrap items-center justify-between gap-4 text-label">
			<p>
				&copy; {new Date().getFullYear()} Jeff Glenn · Memphis,
				Tennessee
			</p>
			<ul class="flex items-center -ml-[11px] sm:ml-0 sm:-mr-[11px]">
				{elsewhere.map((item) => (
					<li>
						<a
							href={item.href}
							class="flex items-center justify-center size-10 rounded-full transition-colors hover:bg-white/15"
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${item.label} (opens in a new tab)`}
						>
							<Icon name={item.icon} aria-hidden="true" class="size-[18px]" />
						</a>
					</li>
				))}
			</ul>
		</footer>
		</div>
	</section>
</Layout>
